<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#EDE7F6">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/textProgress" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#5E35B1" android:textStyle="bold"/>
        <TextView android:id="@+id/textScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#5E35B1" android:textStyle="bold"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:progressTint="#673AB7"/>
    <TextView android:id="@+id/textQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="24dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#212121"/>
    <Button android:id="@+id/opt0" style="@style/Option"/>
    <Button android:id="@+id/opt1" style="@style/Option"/>
    <Button android:id="@+id/opt2" style="@style/Option"/>
    <Button android:id="@+id/opt3" style="@style/Option"/>
    <TextView android:id="@+id/textFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/btnNext" android:layout_width="match_parent" android:layout_height="56dp" android:text="Next" android:textColor="#FFFFFF" android:backgroundTint="#673AB7" android:enabled="false"/>
</LinearLayout>
